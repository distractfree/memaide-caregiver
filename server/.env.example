NODE_ENV="development"
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/memaide?schema=public"
JWT_SECRET="change-this-local-dev-secret"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5273,http://127.0.0.1:5273,http://134.122.115.15:5273,http://caregiver.guardianova.com,https://caregiver.guardianova.com"

# Admin Portal
# NOTE: "admin123" is only for local/class demo. Change this for real production deployment!
ADMIN_PASSWORD="admin123"
ADMIN_JWT_SECRET="change-this-admin-local-secret"
ADMIN_JWT_EXPIRES_IN="8h"

# AI Agent Backend (Anthony)
AI_AGENT_URL=https://ai.guardianova.com
AI_AGENT_WS_URL=wss://ai.guardianova.com
# Standardized name. Anthony's docs sometimes call this AI_AGENT_API; the
# backend falls back to AI_AGENT_API if AI_AGENT_API_KEY is unset, but set
# AI_AGENT_API_KEY here.
AI_AGENT_API_KEY=replace-with-real-key
AI_AGENT_TIMEOUT_MS=5000
AI_CALLBACK_API_KEY=replace-with-callback-key
# Egocentric glasses frame callback controls. These are non-secret limits; the
# route-specific parser leaves the global JSON parser at 10 KB.
AI_FRAME_JSON_LIMIT=1mb
AI_FRAME_MAX_DECODED_BYTES=786432
AI_FRAME_CACHE_TTL_SECONDS=300
AI_FRAME_CACHE_MAX_SESSIONS=50
# How long (minutes) a live AI session may go without recent activity before it
# is treated as stale and no longer joinable. Recent activity is the most recent
# of: latest transcript message, row updatedAt, caregiverJoinedAt,
# emergencySuggestedAt, or startedAt. Defaults to 15 when unset.
AI_SESSION_STALE_MINUTES=15
